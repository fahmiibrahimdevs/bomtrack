[Unit]
Description=BOMTrack — Smart Bill of Materials & Scraper Database Service
After=network.target nginx.service

[Service]
Type=simple
User=midpc
WorkingDirectory=/home/midpc/Projects/tools/bomtrack
ExecStart=/home/midpc/Projects/tools/bomtrack/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8008
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
